<?xml version="1.0"?>
<robot name="omni_wheel_bot">
  <link name="base_footprint">
  </link>

  <!--Base
    link-->
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0.0 0.28" />
      <mass value="0.28" />
      <inertia ixx="0.011666666666667" ixy="0" ixz="0" iyy="0.011666666666667" iyz="0"
        izz="0.011666666666667" />
    </inertial>
    <collision name="collision">
      <origin rpy="0 0 0" xyz="0 0.0 0.28" />
      <geometry>
        <mesh filename="package://omni_wheel_bot/meshes/base.dae" scale="0.01  0.01 0.01" />
      </geometry>
    </collision>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.28" />
      <geometry>
        <mesh filename="package://omni_wheel_bot/meshes/base.dae" scale="0.01 0.01 0.01" />
      </geometry>
    </visual>
  </link>

  <link name="right_wheel">
    <inertial>
      <origin rpy="1.57 0 0" xyz="0 -0.05 0.0" />
      <mass value="0.060" />
      <inertia ixx="1.825e-4" ixy="0" ixz="0.00000000" iyy="1.825e-4" iyz="0" izz="1.825e-4" />
    </inertial>
    <collision name="R_collision">
      <origin rpy="1.57 0 0" xyz="0 -0.05 0.0" />
      <geometry>
        <cylinder length="0.13" radius="0.14" />
      </geometry>
    </collision>
    <visual>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
      <geometry>
        <mesh filename="package://omni_wheel_bot/meshes/wheel.stl" scale="5 5 5" />
      </geometry>
    </visual>
  </link>
  <!-- left_wheel -->
  <link name="left_wheel">
    <inertial>
      <origin rpy="1.57 0 0" xyz="0 -0.05 0.0" />
      <mass value="0.060" />
      <inertia ixx="1.825e-4" ixy="0" ixz="0.00000000" iyy="1.825e-4" iyz="0" izz="1.825e-4" />
    </inertial>
    <collision name="L_collision">
      <origin rpy="1.57 0 0" xyz="0 -0.05 0.0" />
      <geometry>
        <cylinder length="0.13" radius="0.14" />
      </geometry>
    </collision>
    <visual>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
      <geometry>
        <mesh filename="package://omni_wheel_bot/meshes/wheel.stl" scale="5 5 5" />
      </geometry>
    </visual>
  </link>
  <!-- rear_wheel -->
  <link name="rear_wheel">
    <inertial>
      <origin rpy="1.57 0 0" xyz="0 -0.05 0.0" />
      <mass value="0.060" />
      <inertia ixx="1.825e-4" ixy="0" ixz="0.00000000" iyy="1.825e-4" iyz="0" izz="1.825e-4" />
    </inertial>
    <collision name="RR_collision">
      <origin rpy="1.57 0 0" xyz="0 -0.05 0.0" />
      <geometry>
        <cylinder length="0.13" radius="0.14" />
      </geometry>
    </collision>
    <visual>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
      <geometry>
        <mesh filename="package://omni_wheel_bot/meshes/wheel.stl" scale="5 5 5" />
      </geometry>
    </visual>
  </link>

  <!-- Joint -->
  <joint name="footprint_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
    <parent link="base_footprint" />
    <child link="base_link" />
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0.0 0.68 0.18" />
    <parent link="base_link" />
    <child link="right_wheel" />
    <axis xyz="0.0 1.0 0.0" />
    <limit effort="5" velocity="5" />
  </joint>
  <!-- material properties -->
  <gazebo reference="right_wheel">
    <material>Gazebo/Black</material>
  </gazebo>
  <joint name="left_wheel_joint" type="continuous">
    <origin rpy="0 0 -2.0944" xyz="0.593 -0.37 0.16" />
    <parent link="base_link" />
    <child link="left_wheel" />
    <axis xyz="0.0 1.0 0.0" />
    <limit effort="5" velocity="5" />
  </joint>
  <!-- material properties -->
  <gazebo reference="left_wheel">
    <material>Gazebo/Black</material>
  </gazebo>
  <joint name="rear_wheel_joint" type="continuous">
    <origin rpy="0 0 2.0944" xyz="-0.578 -0.34 0.18" />
    <parent link="base_link" />
    <child link="rear_wheel" />
    <axis xyz="0.0 1.0 0.0" />
    <limit effort="5" velocity="5" />
  </joint>
  <!-- material properties -->
  <gazebo reference="rear_wheel">
    <material>Gazebo/Black</material>
  </gazebo>


  <ros2_control name="IgnitionSystem" type="system">
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>
    <!-- <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-15</param>
        <param name="max">15</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint> -->
    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-15</param>
        <param name="max">15</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <!-- <joint name="rear_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-15</param>
        <param name="max">15</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint> -->

  </ros2_control>


  <gazebo>
    <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
      <parameters>
        /home/bhajneet/ros2_ws/src/omni_wheel_bot/config/controller_configuration_velocity.yaml</parameters>
    </plugin>
  </gazebo>
</robot>